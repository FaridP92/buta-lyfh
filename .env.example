# Front (exposé dans le bundle, borné par la RLS). API auto-hébergée, même origine que le site.
VITE_SUPABASE_URL=https://buta.lyfh.fr
VITE_SUPABASE_ANON_KEY=

# Scripts et migrations uniquement, jamais dans une variable VITE_.
# SUPABASE_DB_URL : base du VPS via un tunnel SSH (ssh -L 54321:127.0.0.1:54321 vps), mot de passe dans /opt/buta-backend/.env.
# SUPABASE_DB_SSL_NON_VERIFIE=1 : obligatoire, le certificat TLS de la base est auto-signé.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:motdepasse@127.0.0.1:54321/buta
SUPABASE_DB_SSL_NON_VERIFIE=

# Déploiement VPS (scripts/deploiement.sh)
VPS_HOTE=root@51.77.150.125
VPS_RACINE=/var/www/vhosts/lyfh.fr/buta.lyfh.fr

# Secrets des Edge Functions (dans /opt/buta-backend/.env sur le VPS, jamais ici en clair)
# ANTHROPIC_API_KEY=
# IA_BUDGET_JOUR_EUR=1.5
# IA_MODELE=claude-sonnet-5
# IA_EFFORT=medium
# ANALYSTE_DB_URL=
