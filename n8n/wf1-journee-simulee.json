    {
      "id": "c50f5286-1dd0-4773-a41a-4269d91c150a",
      "name": "Journal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://iuremijuoxkzvfqyrmcc.supabase.co/rest/v1/rpc/journal_run",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Profile",
              "value": "buta"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ p_workflow: $(\"Paramètres\").item.json.workflow, p_statut: $(\"Publier la journée\").item.json.body > 0 ? \"ok\" : \"deja_publie\", p_message: \"journée du \" + $(\"Paramètres\").item.json.jour.slice(8, 10) + \"/\" + $(\"Paramètres\").item.json.jour.slice(5, 7) + ($(\"Publier la journée\").item.json.body > 0 ? \" : \" + $(\"Publier la journée\").item.json.body + \" dossiers publiés\" : \" déjà publiée d'avance, aucun dossier à publier\") + \", vues rafraîchies\", p_lignes: $(\"Publier la journée\").item.json.body, p_debute_le: $(\"Paramètres\").item.json.debut }) }}",
        "options": {
          "timeout": 30000,
