    {
      "id": "95fc0473-084c-4bb3-945c-ffa154c5215f",
      "name": "Exécuter les contrôles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://iuremijuoxkzvfqyrmcc.supabase.co/rest/v1/rpc/executer_controles",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Profile",
              "value": "buta"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "name": "Supabase Buta (service role)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "840df53e-6e8f-46b3-b271-f7d2b5c7a217",
      "name": "Synthèse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r = $input.first().json.body || {};\nconst liste = Array.isArray(r.controles) ? r.controles : [];\nconst ko = liste.filter((c) => c.statut === 'ko');\nconst alertes = liste.filter((c) => c.statut === 'alerte');\nconst score = Number(r.score);\nconst alerter = Boolean(r.bloquant_ko) || score < 90;\nconst jour = String(r.jour || '');\nconst jourCourt = jour.length === 10 ? jour.slice(8, 10) + '/' + jour.slice(5, 7) : jour;\nconst nomme = (l) => l.map((c) => c.controle + ' ' + c.libelle + ' (' + c.nb_lignes + ' lignes)').join(', ');\nconst message = 'score ' + score + '/100 au ' + jourCourt + ', ' + ko.length + ' contrôle(s) bloquant(s) KO' + (ko.length ? ' : ' + ko.map((c) => c.controle).join(', ') : '') + ', ' + alertes.length + ' alerte(s)' + (alertes.length ? ' : ' + alertes.map((c) => c.controle).join(', ') : '') + (alerter ? ', email envoyé' : '');\nconst lignes = liste.map((c) => '- ' + c.controle + ' ' + c.libelle + ' : ' + (c.statut === 'ok' ? 'ok' : c.statut.toUpperCase() + ', ' + c.nb_lignes + ' ligne(s)') + (c.bloquant ? ' (bloquant)' : ''));\nconst texte = 'Contrôles de cohérence du ' + jourCourt + ' : score ' + score + '/100.\\n\\n' + (ko.length ? 'Contrôles bloquants en échec : ' + nomme(ko) + '.\\n' : '') + (alertes.length ? 'Alertes : ' + nomme(alertes) + '.\\n' : '') + '\\nDétail :\\n' + lignes.join('\\n') + '\\n\\nÉcran Qualité : https://buta.lyfh.fr/qualite\\nDémonstrateur personnel, données d\\'activité simulées.';\nconst sujet = 'Buta.Lyfh : contrôles du ' + jourCourt + ', score ' + score + '/100' + (ko.length ? ', ' + ko.length + ' bloquant(s) KO' : '');\nreturn [{ json: { jour, score, alerter, statut: alerter ? 'alerte' : 'ok', message: message.slice(0, 300), sujet, texte, nb_ko: ko.length, nb_alertes: alertes.length, nb_controles: liste.length } }];"
      }
    },
    {
      "id": "f63b9466-e3a9-41be-8bec-27a4414fa762",
      "name": "Bloquant KO ou score < 90 ?",
