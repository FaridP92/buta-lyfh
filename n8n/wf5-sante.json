            },
            {
              "id": "workflow",
              "name": "workflow",
              "value": "WF5",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "a929d8e7-7505-4fa4-a032-172c32467a15",
      "name": "Site buta.lyfh.fr",
