    {
      "id": "2231bdb4-14d9-4d2d-b261-6154c4f795f3",
      "name": "API Supabase (mart_kpi_mensuel)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        780,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://iuremijuoxkzvfqyrmcc.supabase.co/rest/v1/mart_kpi_mensuel",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "mois,agence"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept-Profile",
              "value": "buta"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "supabaseApi": {
          "name": "Supabase Buta (service role)"
        }
      }
    },
    {
      "id": "21f20408-30c2-44d2-83ca-5d0f261da172",
      "name": "Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const site = $('Site buta.lyfh.fr').first().json || {};\nconst api = $input.first().json || {};\nconst siteStatut = Number(site.statusCode || 0);\nconst siteOk = siteStatut === 200 && String(site.html || '').includes('Buta.Lyfh');\nconst apiStatut = Number(api.statusCode || 0);\nconst apiLignes = Array.isArray(api.body) ? api.body.length : 0;\nconst apiOk = apiStatut === 200 && apiLignes >= 1;\nconst ok = siteOk && apiOk;\nconst message = 'site ' + (siteStatut || 'injoignable') + (siteOk ? ' (Buta.Lyfh présent)' : ' (KO)') + ', API ' + (apiStatut || 'injoignable') + ' (' + apiLignes + ' ligne' + (apiLignes > 1 ? 's' : '') + (apiOk ? ')' : ', KO)');\nreturn [{ json: { ok, statut: ok ? 'ok' : 'erreur', message, site_ok: siteOk, api_ok: apiOk, site_statut: siteStatut, api_statut: apiStatut } }];"
      }
    },
    {
      "id": "6a67d373-d9a4-4e02-a89d-bda788ed385f",
      "name": "Journal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1300,
        300
      ],
      "parameters": {
